{
  "name": "ox",
  "scopeName": "source.ox",
  "fileTypes": [
    ".ox"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.ox",
      "match": "\\b(boolean|number|return|false|print|while|else|true|void|and|for|fun|var|if|or)\\b"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.ox",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.ox"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.ox"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.ox"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.ox"
        }
      ]
    }
  }
}
