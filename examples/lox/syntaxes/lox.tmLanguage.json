{
  "name": "lox",
  "scopeName": "source.lox",
  "fileTypes": [
    ".lox"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.lox",
      "match": "\\b(boolean|number|return|string|class|false|print|super|while|else|this|true|void|and|for|fun|nil|var|if|or)\\b"
    },
    {
      "name": "string.quoted.double.lox",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.lox",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.lox"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.lox"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.lox"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.lox"
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.lox",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
